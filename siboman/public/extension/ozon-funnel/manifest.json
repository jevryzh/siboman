{
  "manifest_version": 3,
  "name": "Ozon 我的商品销售",
  "version": "1.2.0",
  "description": "在 Ozon 卖家后台直接查看「我的商品销售」的全部免费指标（销售 + 销售漏斗 + 转化），支持按货号/SKU 搜索、列自定义排序、导出 CSV；不依赖 Premium，独立使用、无需配置密钥。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://seller.ozon.ru/*",
    "https://seller.ozonru.cn/*",
    "https://seller.ozon.kz/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://seller.ozon.ru/*",
        "https://seller.ozonru.cn/*",
        "https://seller.ozon.kz/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
